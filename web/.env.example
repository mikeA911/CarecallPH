10.# Vite only exposes variables prefixed with VITE_ and inlines them at BUILD time.
# NEXT_PUBLIC_* names are ignored by this app. Use the EXACT names below.
#
# Local dev: copy this file to web/.env (this directory), then `npm run dev`.
# Vercel: set the same names under Settings > Environment Variables, then REDEPLOY
# (env changes do not affect an already-built deployment).
#
# The URL and key MUST belong to the same Supabase project. A correct anon JWT
# decodes to "ref":"<the ref in your URL>". You may use either the legacy anon
# key (eyJ...) or the new publishable key (sb_publishable_...).

VITE_SUPABASE_URL=https://<PROJECT_REF>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon key (eyJ...) or publishable key (sb_publishable_...)>

# Feature flags
# D2: multi-clinic switcher stays stubbed (single clinic) until set to true.
VITE_MULTI_CLINIC=false

# CareCall PH — chat opt-in page (/connect/<token>). Each app's button appears
# only when its value is set; order is Viber, Messenger, WhatsApp, Telegram.
VITE_VIBER_CHAT_URI=        # Viber bot URI (the "uri" from bot registration)
VITE_MESSENGER_PAGE=        # Facebook Page username or numeric page id
VITE_WHATSAPP_NUMBER=       # WhatsApp Business number, international digits (e.g. 639171234567)
VITE_TELEGRAM_BOT=          # Telegram bot username, without the @
